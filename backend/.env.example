@"
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/skincare_tracker
SECRET_KEY=local-dev-secret-do-not-use-in-prod
STORAGE_BACKEND=local
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
MAX_IMAGE_SIZE_MB=15
ANTHROPIC_API_KEY=
"@ | Out-File -FilePath ".env.development" -Encoding utf8

# ── ONLY NEEDED FOR PRODUCTION (S3) ───────────────────────
# STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret
# AWS_REGION=us-east-1
# S3_BUCKET=your-bucket-name

# ── OPTIONAL: AI product search ────────────────────────────
# Without this key, only the seeded local products will be searchable
# ANTHROPIC_API_KEY=sk-ant-...
