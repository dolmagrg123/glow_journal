# Copy this file to .env.development (local dev) or .env.production and fill in the values.
# The backend loads the file named by the ENV_FILE environment variable (default: .env.development).
# `setup.ps1` generates .env.development for you.

# ── Required ───────────────────────────────────────────────
# PostgreSQL on Windows often listens on 5433 instead of 5432 — check with: netstat -ano | findstr "543"
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/skincare_tracker
SECRET_KEY=change-me-to-a-long-random-string

# ── App ────────────────────────────────────────────────────
ENVIRONMENT=development
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
MAX_IMAGE_SIZE_MB=15

# ── Photo storage: "local" saves to backend/uploads/, "s3" uses AWS ──
STORAGE_BACKEND=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=

# ── Optional: AI product search / skin analysis ────────────
# Without a key, only the seeded products are searchable.
ANTHROPIC_API_KEY=
