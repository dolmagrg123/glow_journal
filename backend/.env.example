# ── REQUIRED ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/skincare_tracker

# ── OPTIONAL (leave defaults for local dev) ────────────────
SECRET_KEY=local-dev-secret-change-in-production
STORAGE_BACKEND=local
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development

# ── ONLY NEEDED FOR PRODUCTION (S3) ───────────────────────
# STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret
# AWS_REGION=us-east-1
# S3_BUCKET=your-bucket-name

# ── OPTIONAL: AI product search ────────────────────────────
# Without this key, only the seeded local products will be searchable
# ANTHROPIC_API_KEY=sk-ant-...
